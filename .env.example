# =============================================================================
# NIRMAAN-PASS Environment Configuration (.env.local)
# =============================================================================

# 1. Supabase Project Endpoint URL
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anonymous / Publishable Key (Public, client-safe)
# Used in browser and server for client sessions and RLS-protected queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 3. Supabase Service Role Key (Private / Server-Only)
# Bypasses RLS for server-side operations, admin scans, and background jobs.
# NEVER expose this to the browser or client-side code.
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 4. Organizer Console Access Code
# Passcode required to unlock the Admin Console (/admin/*), Queue Scanner,
# and broadcast announcements.
ADMIN_ACCESS_CODE=NIRMAAN2026_ADMIN
